# Hébergement cPanel (LiteSpeed/Apache). Chaque page publique est un fichier HTML pré-rendu
# (catalogue.html, produit/cumax.html…) servi à une adresse propre (/catalogue, /produit/cumax).
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# HTTPS et domaine sans « www » : une seule adresse par page.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Anciennes adresses produits → adresses actuelles.
RewriteRule ^produit/?$ /catalogue [L,R=301]
RewriteRule ^produit/anti-inflammatoire/?$ /produit/cumax [L,R=301]
RewriteRule ^produit/decontractant/?$ /produit/deconat [L,R=301]
# Nobal retiré de la gamme : ses anciennes adresses mènent au catalogue.
RewriteRule ^produit/(?:nobal|anti-ballonnement)/?$ /catalogue [L,R=301]
RewriteRule ^produit/magnesium/?$ /produit/ociamag [L,R=301]
RewriteRule ^produit/stimulant-appetit/?$ /produit/grofen [L,R=301]
RewriteRule ^produit/sirop-toux/?$ /produit/respinat-enfant [L,R=301]

# /index.html → /, /page.html → /page (évite les doublons).
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteCond %1 !^404$
# Fichier de validation Google Search Console : servi tel quel, sans redirection.
RewriteCond %1 !^google[0-9a-f]+$
RewriteRule ^ /%1 [L,R=301]

# Barre oblique finale superflue → adresse sans barre (sauf vrais dossiers, pour éviter une boucle).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# Adresse propre → fichier pré-rendu.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Fichiers versionnés par Vite : cache long. Pages HTML : toujours revalidées.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images non versionnées : 1 jour seulement, pour qu'une photo remplacée apparaisse vite.
  # Pour un changement immédiat, donner un nouveau nom au fichier (ex. logo-pharmavert.png).
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
